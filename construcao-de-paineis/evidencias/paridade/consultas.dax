// corte: total
EVALUATE
    ROW (
        "corte", "total",
        "chave", "total",
        "receita_bruta", [Receita Bruta (R$)],
        "receita_liquida", [Receita Liquida (R$)],
        "participacao", [Participacao na Receita (%)],
        "desconto", [Desconto Concedido (R$)],
        "desconto_pct", [Desconto Medio (%)],
        "custo", [Custo (R$)],
        "margem", [Margem (R$)],
        "margem_pct", [Margem (%)],
        "pedidos", [Pedidos],
        "quantidade", [Quantidade (un)],
        "ticket_medio", [Ticket Medio (R$)],
        "clientes_ativos", [Clientes Ativos],
        "base_clientes_12m", [Base de Clientes 12 Meses],
        "clientes_sem_compra_90d", [Clientes sem Compra 90 Dias],
        "clientes_sem_compra_90d_pct", [Clientes sem Compra 90 Dias (%)],
        "receita_ano_anterior", [Receita Ano Anterior (R$)],
        "crescimento_pct", [Crescimento sobre Ano Anterior (%)],
        "margem_ano_anterior_pct", [Margem Ano Anterior (%)],
        "variacao_margem_pp", [Variacao Margem sobre Ano Anterior (p.p.)],
        "receita_acumulada_ano", [Receita Acumulada no Ano (R$)]
    )

// corte: ano_mes
EVALUATE
    SELECTCOLUMNS (
        SUMMARIZECOLUMNS (
            Dim_Calendario[Ano],
            Dim_Calendario[Mes],
            "receita_bruta", [Receita Bruta (R$)],
            "receita_liquida", [Receita Liquida (R$)],
            "participacao", [Participacao na Receita (%)],
            "desconto", [Desconto Concedido (R$)],
            "desconto_pct", [Desconto Medio (%)],
            "custo", [Custo (R$)],
            "margem", [Margem (R$)],
            "margem_pct", [Margem (%)],
            "pedidos", [Pedidos],
            "quantidade", [Quantidade (un)],
            "ticket_medio", [Ticket Medio (R$)],
            "clientes_ativos", [Clientes Ativos],
            "base_clientes_12m", [Base de Clientes 12 Meses],
            "clientes_sem_compra_90d", [Clientes sem Compra 90 Dias],
            "clientes_sem_compra_90d_pct", [Clientes sem Compra 90 Dias (%)],
            "receita_ano_anterior", [Receita Ano Anterior (R$)],
            "crescimento_pct", [Crescimento sobre Ano Anterior (%)],
            "margem_ano_anterior_pct", [Margem Ano Anterior (%)],
            "variacao_margem_pp", [Variacao Margem sobre Ano Anterior (p.p.)],
            "receita_acumulada_ano", [Receita Acumulada no Ano (R$)]
        ),
        "corte", "ano_mes",
        "chave", Dim_Calendario[Ano] & "-" & FORMAT ( Dim_Calendario[Mes], "00" ),
        "receita_bruta", [receita_bruta],
        "receita_liquida", [receita_liquida],
        "participacao", [participacao],
        "desconto", [desconto],
        "desconto_pct", [desconto_pct],
        "custo", [custo],
        "margem", [margem],
        "margem_pct", [margem_pct],
        "pedidos", [pedidos],
        "quantidade", [quantidade],
        "ticket_medio", [ticket_medio],
        "clientes_ativos", [clientes_ativos],
        "base_clientes_12m", [base_clientes_12m],
        "clientes_sem_compra_90d", [clientes_sem_compra_90d],
        "clientes_sem_compra_90d_pct", [clientes_sem_compra_90d_pct],
        "receita_ano_anterior", [receita_ano_anterior],
