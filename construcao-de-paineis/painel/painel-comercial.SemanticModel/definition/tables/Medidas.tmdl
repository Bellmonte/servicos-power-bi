			        0
			    )
		formatString: 0
		isHidden
		displayFolder: .Internas\UI
		lineageTag: fcb87794-2c54-4bee-bc66-0e3fc130d33e

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    TiposAjustados = Table.TransformColumnTypes(Fonte, {{"Coluna 1", type text}}),
				    ColunasRemovidas = Table.RemoveColumns(TiposAjustados, {"Coluna 1"})
				in
				    ColunasRemovidas

	annotation PBI_ResultType = Table

