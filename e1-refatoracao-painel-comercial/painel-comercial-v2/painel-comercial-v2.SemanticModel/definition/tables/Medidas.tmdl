/// Tabela de medidas, sem coluna de dado. Toda medida do modelo mora aqui, em pastas numeradas por assunto.
table Medidas
	lineageTag: 96a5c759-471e-421b-8c15-0ebde670c7b1

	/// Receita a preço de tabela, antes do desconto: soma do valor bruto de cada item; em reais, duas casas. Use para ver o efeito do desconto; não use como faturamento do período, que é a Receita Liquida (R$).
	measure 'Receita Bruta (R$)' = SUM ( Fact_Vendas[Valor Bruto] )
		formatString: \R\$ #,0.00
		displayFolder: 01 Receita
		lineageTag: 34a0f08f-3bee-567d-95c4-d34fc0e9ef80

	/// Faturamento do período, já descontado: soma do valor líquido de cada item; em reais, duas casas. Use como indicador principal de receita em qualquer recorte; não use para margem, que tem medida própria.
	measure 'Receita Liquida (R$)' = SUM ( Fact_Vendas[Valor Liquido] )
		formatString: \R\$ #,0.00
		displayFolder: 01 Receita
		lineageTag: 8ce48279-9d0a-56a4-89d9-1c2089fbb55c

	/// Receita líquida só da Linha Premium, intersectando com o filtro de linha que estiver na tela; em reais, duas casas. Use para acompanhar a linha de maior valor; não use para outra linha, porque a linha é fixa na fórmula.
	measure 'Receita Linha Premium (R$)' =
			CALCULATE (
			    [Receita Liquida (R$)],
			    KEEPFILTERS ( Dim_Produto[Linha de Produto] = "Linha Premium" )
			)
		formatString: \R\$ #,0.00
		displayFolder: 01 Receita
		lineageTag: b4b5c3fc-7193-5ee0-8f33-76279961eda2

	/// Receita líquida do recorte dividida pela de todas as regiões; percentual, uma casa. Use para comparar a fatia de cada região com o peso de mercado; não use fora de um corte por região, porque sem ele dá 100%.
	measure 'Participacao na Receita (%)' =
			DIVIDE (
			    [Receita Liquida (R$)],
			    CALCULATE (
			        [Receita Liquida (R$)],
			        REMOVEFILTERS ( Dim_Regiao )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Receita
		lineageTag: 077cf151-ecda-5a78-adf0-09222902b43c

	/// Receita da Linha Premium dividida pela receita líquida sem o filtro de linha de produto; percentual, uma casa. Use no complemento do cartão da Linha Premium; não use como participação de outra linha.
	measure 'Participacao Linha Premium na Receita (%)' =
			DIVIDE (
			    [Receita Linha Premium (R$)],
			    CALCULATE (
			        [Receita Liquida (R$)],
			        REMOVEFILTERS ( Dim_Produto[Linha de Produto] )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Receita
		lineageTag: d8f0cdc6-c96c-47d5-aef6-83827d621a91

	/// Custo dos itens vendidos: soma do custo total de cada item; em reais, duas casas. Use junto da receita para explicar a margem; não use como despesa da operação, que não está na base.
	measure 'Custo (R$)' = SUM ( Fact_Vendas[Valor Custo] )
		formatString: \R\$ #,0.00
		displayFolder: 02 Margem
		lineageTag: bb2c0e85-d8ea-5eb3-9087-f70befef9d2f

	/// Margem bruta do período: soma da margem de cada item, que é o líquido menos o custo; em reais, duas casas. Use para resultado em valor; não use para comparar recortes de tamanho diferente, que pedem a Margem (%).
	measure 'Margem (R$)' = SUM ( Fact_Vendas[Valor Margem] )
		formatString: \R\$ #,0.00
		displayFolder: 02 Margem
		lineageTag: a529bcb5-a938-56d5-9bec-ca974acacfff

	/// Margem sobre a receita líquida, razão das somas e nunca média das razões; percentual, uma casa. Use para comparar rentabilidade entre recortes; não some nem tire média entre linhas.
	measure 'Margem (%)' = DIVIDE ( [Margem (R$)], [Receita Liquida (R$)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Margem
		lineageTag: 9c19eeff-86db-530f-9aee-ae57b1f390a5

	/// Unidades vendidas: soma da quantidade de cada item; inteiro. Use para volume; não compare com valor sem passar pelo preço ou pelo ticket.
	measure 'Quantidade (un)' = SUM ( Fact_Vendas[Quantidade Vendida] )
		formatString: #,0
		displayFolder: 03 Volume e Pedidos
		lineageTag: 7b4b6a0f-7fde-50e8-b03e-1054f4a1786a

	/// Pedidos distintos no recorte; inteiro. Use para frequência de compra e para o ticket; não some entre recortes, porque o mesmo pedido pode ter itens em mais de um.
	measure Pedidos = DISTINCTCOUNT ( Fact_Vendas[Numero Pedido] )
		formatString: #,0
		displayFolder: 03 Volume e Pedidos
		lineageTag: 60ad13e7-c00f-54eb-9147-161ad56c920e

	/// Receita líquida por pedido, razão das somas; em reais, duas casas. Use para valor médio de compra; não use como média de preço de produto.
	measure 'Ticket Medio (R$)' = DIVIDE ( [Receita Liquida (R$)], [Pedidos] )
		formatString: \R\$ #,0.00
		displayFolder: 03 Volume e Pedidos
		lineageTag: c3efaae8-38b1-5488-a43b-621406b9d884

	/// Itens de venda no recorte, uma linha da fato por item; inteiro. Use como controle técnico na paridade contra a base; não use como volume de negócio, que é a Quantidade (un).
	measure 'Linhas de Venda' = COUNTROWS ( Fact_Vendas )
		formatString: #,0
		displayFolder: 03 Volume e Pedidos
		lineageTag: bec18429-9ec9-5e20-829b-36054cf50f6b

	/// Clientes distintos com venda no recorte, contados pela chave; inteiro. Use para alcance da carteira; não some entre meses, porque o mesmo cliente se repete.
	measure 'Clientes com Compra' = DISTINCTCOUNT ( Fact_Vendas[ID Cliente] )
		formatString: #,0
		displayFolder: 04 Clientes e Mercado
		lineageTag: 397ebf2c-4be0-53cc-b132-a4c3a1e9f6d2

	/// Peso da região no mercado, como vem do cadastro de regiões; percentual, uma casa. Use ao lado da Participacao na Receita (%); não use somado entre períodos.
	measure 'Peso de Mercado (%)' = SUM ( Dim_Regiao[Peso Mercado] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Clientes e Mercado
		lineageTag: 3647eca8-2828-5d2e-b188-660f7cf1d585

	/// Receita líquida no mesmo período do ano anterior, deslocando as datas do contexto pelo calendário; em reais, duas casas. Use para comparar com o ano anterior; não use no primeiro ano da base, que volta vazio.
	measure 'Receita Ano Anterior (R$)' =
			CALCULATE (
			    [Receita Liquida (R$)],
			    DATEADD ( Dim_Calendario[Data], -1, YEAR )
			)
		formatString: \R\$ #,0.00
		displayFolder: 05 Ano Anterior e Acumulado
		lineageTag: 34e33383-2654-5ecb-9856-91070567dc99

	/// Receita líquida de 1º de janeiro até a última data do contexto, no mesmo ano; em reais, duas casas. Use na evolução acumulada; não some com a receita do mês.
	measure 'Receita Acumulada no Ano (R$)' =
			CALCULATE (
			    [Receita Liquida (R$)],
			    DATESYTD ( Dim_Calendario[Data] )
			)
		formatString: \R\$ #,0.00
		displayFolder: 05 Ano Anterior e Acumulado
		lineageTag: 7188044f-42f1-5a19-a1d0-cec8b7d34165

	/// Variação da receita líquida sobre o mesmo período do ano anterior; percentual com seta e sinal, uma casa. Use para crescimento anual; vazio quando não há ano anterior na base, e nunca zero.
	measure 'Crescimento sobre Ano Anterior (%)' =
			VAR v_atual = [Receita Liquida (R$)]
			VAR v_anterior = [Receita Ano Anterior (R$)]
			RETURN
			    IF ( ISBLANK ( v_anterior ), BLANK (), DIVIDE ( v_atual - v_anterior, v_anterior ) )
		formatString: ▲ +0.0%;▼ -0.0%;0.0%
		displayFolder: 05 Ano Anterior e Acumulado
		lineageTag: c2490c0f-3ebd-593f-abe3-c9479b52449b

	/// Receita Liquida (R$) no mês anterior ao do contexto, deslocando as datas pelo calendário; mesmo formato da medida base. Use no rótulo de referência do cartão; só existe com um único mês no contexto e volta vazia com mais de um.
	measure 'Receita Liquida Mes Anterior (R$)' =
			IF (
			    HASONEVALUE ( Dim_Calendario[Mes.Ano] ),
			    CALCULATE (
			        [Receita Liquida (R$)],
			        DATEADD ( Dim_Calendario[Data], -1, MONTH )
			    )
			)
		formatString: \R\$ #,0.00
		displayFolder: 06 Mes Anterior
		lineageTag: 220b800e-c9af-4e69-a4ad-8a105dfd9c16

	/// Variação de Receita Liquida (R$) contra o mês anterior; percentual, uma casa. Use no detalhe do cartão; vazia sem mês anterior ou com mais de um mês no contexto, e nunca zero.
	measure 'Variacao Receita vs Mes Anterior (%)' =
			VAR v_atual = [Receita Liquida (R$)]
			VAR v_anterior = [Receita Liquida Mes Anterior (R$)]
			RETURN
			    IF ( ISBLANK ( v_anterior ), BLANK (), DIVIDE ( v_atual - v_anterior, v_anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Mes Anterior
		lineageTag: ae1b8a78-c291-4b32-a359-97c27c4a9bb9

	/// Texto do detalhe do cartão: seta e Variacao Receita vs Mes Anterior (%). Oculta.
	measure '.ux_var_receita' =
			VAR v_var = [Variacao Receita vs Mes Anterior (%)]
			VAR v_seta = IF ( v_var >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF ( NOT ISBLANK ( v_var ), v_seta & " " & FORMAT ( v_var, "0.0%", "pt-BR" ) )
		isHidden
		displayFolder: .Internas\UI
		lineageTag: bcce7b05-3107-40d8-b289-4a258e054a20

	/// Código de cor do detalhe do cartão para Variacao Receita vs Mes Anterior (%): 0 sem comparação, 1 favorável, 2 desfavorável. A regra condicional do cartão lê este código. Oculta.
	measure '.cor_var_receita' =
			VAR v_var = [Variacao Receita vs Mes Anterior (%)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v_var ), 0,
			        v_var >= 0, 1,
			        2
			    )
		formatString: 0
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 37f93ac4-98d8-43c6-92d6-0c2076501f0e

	/// Margem (R$) no mês anterior ao do contexto, deslocando as datas pelo calendário; mesmo formato da medida base. Use no rótulo de referência do cartão; só existe com um único mês no contexto e volta vazia com mais de um.
	measure 'Margem Mes Anterior (R$)' =
			IF (
			    HASONEVALUE ( Dim_Calendario[Mes.Ano] ),
			    CALCULATE (
			        [Margem (R$)],
			        DATEADD ( Dim_Calendario[Data], -1, MONTH )
			    )
			)
		formatString: \R\$ #,0.00
		displayFolder: 06 Mes Anterior
		lineageTag: 78d68c2a-3393-4a87-84d9-9c6b62fa5b8d

	/// Variação de Margem (R$) contra o mês anterior; percentual, uma casa. O denominador é o valor absoluto, para o sinal não inverter com margem negativa. Use no detalhe do cartão; vazia sem mês anterior ou com mais de um mês no contexto, e nunca zero.
	measure 'Variacao Margem vs Mes Anterior (%)' =
			VAR v_atual = [Margem (R$)]
			VAR v_anterior = [Margem Mes Anterior (R$)]
			RETURN
			    IF ( ISBLANK ( v_anterior ), BLANK (), DIVIDE ( v_atual - v_anterior, ABS ( v_anterior ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Mes Anterior
		lineageTag: 2b3c2da4-7807-469c-b0d5-66ef91d1e2e1

	/// Texto do detalhe do cartão: seta e Variacao Margem vs Mes Anterior (%). Oculta.
	measure '.ux_var_margem' =
			VAR v_var = [Variacao Margem vs Mes Anterior (%)]
			VAR v_seta = IF ( v_var >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF ( NOT ISBLANK ( v_var ), v_seta & " " & FORMAT ( v_var, "0.0%", "pt-BR" ) )
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 92b18e2f-cd05-4495-bba4-ff1f27edd284

	/// Código de cor do detalhe do cartão para Variacao Margem vs Mes Anterior (%): 0 sem comparação, 1 favorável, 2 desfavorável. A regra condicional do cartão lê este código. Oculta.
	measure '.cor_var_margem' =
			VAR v_var = [Variacao Margem vs Mes Anterior (%)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v_var ), 0,
			        v_var >= 0, 1,
			        2
			    )
		formatString: 0
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 094e2fed-d16e-4ca0-a7e0-144222876f4f

	/// Margem (%) no mês anterior ao do contexto, deslocando as datas pelo calendário; mesmo formato da medida base. Use no rótulo de referência do cartão; só existe com um único mês no contexto e volta vazia com mais de um.
	measure 'Margem Mes Anterior (%)' =
			IF (
			    HASONEVALUE ( Dim_Calendario[Mes.Ano] ),
			    CALCULATE (
			        [Margem (%)],
			        DATEADD ( Dim_Calendario[Data], -1, MONTH )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Mes Anterior
		lineageTag: e14173fd-eaa9-4449-99ec-c9e67353d33b

	/// Diferença da margem percentual contra o mês anterior, em pontos percentuais, uma casa. Use no detalhe do cartão; vazia sem mês anterior ou com mais de um mês no contexto.
	measure 'Variacao Margem vs Mes Anterior (p.p.)' =
			VAR v_atual = [Margem (%)]
			VAR v_anterior = [Margem Mes Anterior (%)]
			RETURN
			    IF ( ISBLANK ( v_anterior ) || ISBLANK ( v_atual ), BLANK (), ( v_atual - v_anterior ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 06 Mes Anterior
		lineageTag: 5b88d7e4-d67c-41c0-a699-b3cd6bc5083f

	/// Texto do detalhe do cartão: seta e Variacao Margem vs Mes Anterior (p.p.). Oculta.
	measure '.ux_var_margem_pct' =
			VAR v_var = [Variacao Margem vs Mes Anterior (p.p.)]
			VAR v_seta = IF ( v_var >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF ( NOT ISBLANK ( v_var ), v_seta & " " & FORMAT ( v_var, "0.0", "pt-BR" ) & " p.p." )
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 40f642fa-6861-479f-9552-1bd717cb4e12

	/// Código de cor do detalhe do cartão para Variacao Margem vs Mes Anterior (p.p.): 0 sem comparação, 1 favorável, 2 desfavorável. A regra condicional do cartão lê este código. Oculta.
	measure '.cor_var_margem_pct' =
			VAR v_var = [Variacao Margem vs Mes Anterior (p.p.)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v_var ), 0,
			        v_var >= 0, 1,
			        2
			    )
		formatString: 0
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 5fe5e9be-154f-45e9-8215-a1c665fecad3

	/// Quantidade (un) no mês anterior ao do contexto, deslocando as datas pelo calendário; mesmo formato da medida base. Use no rótulo de referência do cartão; só existe com um único mês no contexto e volta vazia com mais de um.
	measure 'Quantidade Mes Anterior (un)' =
			IF (
			    HASONEVALUE ( Dim_Calendario[Mes.Ano] ),
			    CALCULATE (
			        [Quantidade (un)],
			        DATEADD ( Dim_Calendario[Data], -1, MONTH )
			    )
			)
		formatString: #,0
		displayFolder: 06 Mes Anterior
		lineageTag: 095f7780-9b40-470c-a17d-c8a7052cf2a9

	/// Variação de Quantidade (un) contra o mês anterior; percentual, uma casa. Use no detalhe do cartão; vazia sem mês anterior ou com mais de um mês no contexto, e nunca zero.
	measure 'Variacao Quantidade vs Mes Anterior (%)' =
			VAR v_atual = [Quantidade (un)]
			VAR v_anterior = [Quantidade Mes Anterior (un)]
			RETURN
			    IF ( ISBLANK ( v_anterior ), BLANK (), DIVIDE ( v_atual - v_anterior, v_anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Mes Anterior
		lineageTag: 9ca54596-b745-4341-aaf2-6c47d011d912

	/// Texto do detalhe do cartão: seta e Variacao Quantidade vs Mes Anterior (%). Oculta.
	measure '.ux_var_quantidade' =
