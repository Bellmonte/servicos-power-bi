	/// Clientes com Compra no mês anterior ao do contexto, deslocando as datas pelo calendário; mesmo formato da medida base. Use no rótulo de referência do cartão; só existe com um único mês no contexto e volta vazia com mais de um.
	measure 'Clientes com Compra Mes Anterior' =
			IF (
			    HASONEVALUE ( Dim_Calendario[Mes.Ano] ),
			    CALCULATE (
			        [Clientes com Compra],
			        DATEADD ( Dim_Calendario[Data], -1, MONTH )
			    )
			)
		formatString: #,0
		displayFolder: 06 Mes Anterior
		lineageTag: 922620ac-df74-4f09-87d4-3f4b31d8b451

	/// Variação de Clientes com Compra contra o mês anterior; percentual, uma casa. Use no detalhe do cartão; vazia sem mês anterior ou com mais de um mês no contexto, e nunca zero.
	measure 'Variacao Clientes vs Mes Anterior (%)' =
			VAR v_atual = [Clientes com Compra]
			VAR v_anterior = [Clientes com Compra Mes Anterior]
			RETURN
			    IF ( ISBLANK ( v_anterior ), BLANK (), DIVIDE ( v_atual - v_anterior, v_anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Mes Anterior
		lineageTag: 841e706b-05ca-494f-82dd-74df0361e438

	/// Texto do detalhe do cartão: seta e Variacao Clientes vs Mes Anterior (%). Oculta.
	measure '.ux_var_clientes' =
			VAR v_var = [Variacao Clientes vs Mes Anterior (%)]
			VAR v_seta = IF ( v_var >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF ( NOT ISBLANK ( v_var ), v_seta & " " & FORMAT ( v_var, "0.0%", "pt-BR" ) )
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 4d8c5ee7-3faf-4fc8-b97c-258046736752

	/// Código de cor do detalhe do cartão para Variacao Clientes vs Mes Anterior (%): 0 sem comparação, 1 favorável, 2 desfavorável. A regra condicional do cartão lê este código. Oculta.
	measure '.cor_var_clientes' =
			VAR v_var = [Variacao Clientes vs Mes Anterior (%)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v_var ), 0,
			        v_var >= 0, 1,
			        2
			    )
		formatString: 0
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 691fedec-641e-4c03-a5ed-c7a066ab00cf

	/// Texto do rodapé de todas as páginas: origem do dado, janela da base, unidade e recorte. Oculta.
	measure '.rodape_pagina' =
			VAR v_inicio =
			    CALCULATE (
			        MIN ( Dim_Calendario[Data] ),
			        REMOVEFILTERS ( Dim_Calendario )
			    )
			VAR v_fim =
			    CALCULATE (
			        MAX ( Dim_Calendario[Data] ),
			        REMOVEFILTERS ( Dim_Calendario )
			    )
			RETURN
			    "Dado 100% sintético, gerado para demonstração · vendas de "
			        & FORMAT ( v_inicio, "mmm/yyyy", "pt-BR" ) & " até " & FORMAT ( v_fim, "dd/mm/yyyy", "pt-BR" )
			        & " · valores em R$ · região é a do cliente · B&B · Matheus Belmonte"
		isHidden
		displayFolder: .Texto
		lineageTag: 5c95c8cb-411e-4991-95a9-44ba18fcbe7d

	/// Texto de Receita Liquida (R$) no cartão de indicadores, escrito com FORMAT na cultura pt-BR e formato curto por faixa: R$ 10,6 Bi a partir de um bilhão, R$ 952 Mi de cem milhões para cima, R$ 24,8 Mi a partir de um milhão e R$ 339.930 abaixo disso; vazio quando a medida base é vazia, e o cartão mostra o hífen. Use só no valor do bloco Receita líquida da Visão geral; não use em tabela, gráfico, exportação nem paridade, que usam a medida base com formato fixo, nem em ordenação ou regra de cor, porque o resultado é texto.
	measure '.kpi_receita' =
			VAR v_valor = [Receita Liquida (R$)]
			VAR v_abs = ABS ( v_valor )
			VAR _sinal = IF ( v_valor < 0, "-" )
			VAR _numero =
			    SWITCH (
			        TRUE (),
			        -- cada corte fica meio passo abaixo da fronteira, para o arredondamento não escrever "1.000 Mi"
			        v_abs >= 999500000, FORMAT ( v_abs / 1000000000, "#,0.0", "pt-BR" ) & " Bi",
			        v_abs >= 99950000, FORMAT ( v_abs / 1000000, "#,0", "pt-BR" ) & " Mi",
			        v_abs >= 999950, FORMAT ( v_abs / 1000000, "#,0.0", "pt-BR" ) & " Mi",
			        FORMAT ( v_abs, "#,0", "pt-BR" )
			    )
			RETURN
			    IF ( NOT ISBLANK ( v_valor ), _sinal & "R$ " & _numero )
		isHidden
		displayFolder: .Internas\UI
		lineageTag: 2548d9b2-6ef6-47fb-9aa9-e291ef500d59

