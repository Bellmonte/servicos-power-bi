		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Mes Anterior
		lineageTag: e8fceb9d-5be4-414f-9953-640a037d31a7

	/// Texto do detalhe do cartão: seta e Variacao Ticket Medio vs Mes Anterior (%). Oculta.
	measure '.ux_var_ticket' =
