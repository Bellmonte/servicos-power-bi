		lineageTag: 4d755264-2daf-4894-b27c-7fc0bc1e809c

	/// Pedidos no mês anterior ao do contexto, deslocando as datas pelo calendário; mesmo formato da medida base. Use no rótulo de referência do cartão; só existe com um único mês no contexto e volta vazia com mais de um.
	measure 'Pedidos Mes Anterior' =
