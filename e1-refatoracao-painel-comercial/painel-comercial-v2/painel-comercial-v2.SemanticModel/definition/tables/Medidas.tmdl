			    IF ( NOT ISBLANK ( v_var ), v_seta & " " & FORMAT ( v_var, "0.0%", "pt-BR" ) )
		isHidden
		displayFolder: .Internas\UI
		lineageTag: a707b697-e451-4cba-af42-374441a3cfe6

	/// Código de cor do detalhe do cartão para Variacao Quantidade vs Mes Anterior (%): 0 sem comparação, 1 favorável, 2 desfavorável. A regra condicional do cartão lê este código. Oculta.
