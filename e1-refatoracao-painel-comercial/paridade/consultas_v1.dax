// corte: total
DEFINE
    MEASURE Vendas[par_receita_bruta] = SUM(Vendas[receita_bruta])
    MEASURE Vendas[par_receita_liquida] = SUM(Vendas[receita_liquida])
    MEASURE Vendas[par_custo] = SUM(Vendas[custo_total])
    MEASURE Vendas[par_margem] = SUM(Vendas[Lucro])
    MEASURE Vendas[par_margem_pct] = [Margem %]
    MEASURE Vendas[par_quantidade] = SUM(Vendas[quantidade])
    MEASURE Vendas[par_linhas] = COUNTROWS(Vendas)
    MEASURE Vendas[par_pedidos] = DISTINCTCOUNT(Vendas[numero_pedido])
    MEASURE Vendas[par_ticket_medio] = [Ticket Médio]
    MEASURE Vendas[par_clientes_com_compra] = [Clientes com Compra]
    MEASURE Vendas[par_receita_premium] = [Receita Linha Premium]
    MEASURE Vendas[par_receita_ano_anterior] = [Receita Ano Anterior]
    MEASURE Vendas[par_receita_acumulada_ano] = [Receita Acumulada no Ano]
    MEASURE Vendas[par_crescimento_pct] = [Crescimento sobre Ano Anterior %]
    MEASURE Vendas[par_participacao] = [Participação na Receita]
    MEASURE Vendas[par_peso_mercado] = SUM(Regioes[peso_mercado])
EVALUATE
    ROW(
        "corte", "total",
        "chave", "total",
        "receita_bruta", [par_receita_bruta],
        "receita_liquida", [par_receita_liquida],
        "custo", [par_custo],
        "margem", [par_margem],
        "margem_pct", [par_margem_pct],
        "quantidade", [par_quantidade],
        "linhas", [par_linhas],
        "pedidos", [par_pedidos],
        "ticket_medio", [par_ticket_medio],
        "clientes_com_compra", [par_clientes_com_compra],
        "receita_premium", [par_receita_premium],
        "receita_ano_anterior", [par_receita_ano_anterior],
        "receita_acumulada_ano", [par_receita_acumulada_ano],
        "crescimento_pct", [par_crescimento_pct],
        "participacao", [par_participacao],
        "peso_mercado", [par_peso_mercado]
    )

// corte: ano_mes
DEFINE
    MEASURE Vendas[par_receita_bruta] = SUM(Vendas[receita_bruta])
    MEASURE Vendas[par_receita_liquida] = SUM(Vendas[receita_liquida])
