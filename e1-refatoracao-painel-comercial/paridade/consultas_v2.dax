// corte: total
DEFINE
    MEASURE Medidas[par_receita_bruta] = [Receita Bruta (R$)]
    MEASURE Medidas[par_receita_liquida] = [Receita Liquida (R$)]
    MEASURE Medidas[par_custo] = [Custo (R$)]
    MEASURE Medidas[par_margem] = [Margem (R$)]
    MEASURE Medidas[par_margem_pct] = [Margem (%)]
    MEASURE Medidas[par_quantidade] = [Quantidade (un)]
    MEASURE Medidas[par_linhas] = [Linhas de Venda]
    MEASURE Medidas[par_pedidos] = [Pedidos]
    MEASURE Medidas[par_ticket_medio] = [Ticket Medio (R$)]
    MEASURE Medidas[par_clientes_com_compra] = [Clientes com Compra]
    MEASURE Medidas[par_receita_premium] = [Receita Linha Premium (R$)]
    MEASURE Medidas[par_receita_ano_anterior] = [Receita Ano Anterior (R$)]
    MEASURE Medidas[par_receita_acumulada_ano] = [Receita Acumulada no Ano (R$)]
    MEASURE Medidas[par_crescimento_pct] = [Crescimento sobre Ano Anterior (%)]
    MEASURE Medidas[par_participacao] = [Participacao na Receita (%)]
    MEASURE Medidas[par_peso_mercado] = [Peso de Mercado (%)]
EVALUATE
    ROW(
        "corte", "total",
        "chave", "total",
        "receita_bruta", [par_receita_bruta],
        "receita_liquida", [par_receita_liquida],
        "custo", [par_custo],
        "margem", [par_margem],
        "margem_pct", [par_margem_pct],
        "quantidade", [par_quantidade],
        "linhas", [par_linhas],
        "pedidos", [par_pedidos],
        "ticket_medio", [par_ticket_medio],
        "clientes_com_compra", [par_clientes_com_compra],
        "receita_premium", [par_receita_premium],
        "receita_ano_anterior", [par_receita_ano_anterior],
        "receita_acumulada_ano", [par_receita_acumulada_ano],
        "crescimento_pct", [par_crescimento_pct],
        "participacao", [par_participacao],
        "peso_mercado", [par_peso_mercado]
    )

// corte: ano_mes
DEFINE
    MEASURE Medidas[par_receita_bruta] = [Receita Bruta (R$)]
    MEASURE Medidas[par_receita_liquida] = [Receita Liquida (R$)]
    MEASURE Medidas[par_custo] = [Custo (R$)]
    MEASURE Medidas[par_margem] = [Margem (R$)]
    MEASURE Medidas[par_margem_pct] = [Margem (%)]
    MEASURE Medidas[par_quantidade] = [Quantidade (un)]
    MEASURE Medidas[par_linhas] = [Linhas de Venda]
    MEASURE Medidas[par_pedidos] = [Pedidos]
    MEASURE Medidas[par_ticket_medio] = [Ticket Medio (R$)]
    MEASURE Medidas[par_clientes_com_compra] = [Clientes com Compra]
    MEASURE Medidas[par_receita_premium] = [Receita Linha Premium (R$)]
    MEASURE Medidas[par_receita_ano_anterior] = [Receita Ano Anterior (R$)]
    MEASURE Medidas[par_receita_acumulada_ano] = [Receita Acumulada no Ano (R$)]
    MEASURE Medidas[par_crescimento_pct] = [Crescimento sobre Ano Anterior (%)]
    MEASURE Medidas[par_participacao] = [Participacao na Receita (%)]
    MEASURE Medidas[par_peso_mercado] = [Peso de Mercado (%)]
EVALUATE
SELECTCOLUMNS(
    SUMMARIZECOLUMNS(
        Dim_Calendario[Ano], Dim_Calendario[Mes],
        "v_receita_bruta", [par_receita_bruta],
        "v_receita_liquida", [par_receita_liquida],
        "v_custo", [par_custo],
        "v_margem", [par_margem],
        "v_margem_pct", [par_margem_pct],
        "v_quantidade", [par_quantidade],
        "v_linhas", [par_linhas],
        "v_pedidos", [par_pedidos],
        "v_ticket_medio", [par_ticket_medio],
        "v_clientes_com_compra", [par_clientes_com_compra],
        "v_receita_premium", [par_receita_premium],
        "v_receita_ano_anterior", [par_receita_ano_anterior],
        "v_receita_acumulada_ano", [par_receita_acumulada_ano],
        "v_crescimento_pct", [par_crescimento_pct],
        "v_participacao", [par_participacao],
        "v_peso_mercado", [par_peso_mercado]
    ),
    "corte", "ano_mes",
    "chave", Dim_Calendario[Ano] & "-" & FORMAT(Dim_Calendario[Mes], "00"),
    "receita_bruta", [v_receita_bruta],
    "receita_liquida", [v_receita_liquida],
    "custo", [v_custo],
    "margem", [v_margem],
    "margem_pct", [v_margem_pct],
    "quantidade", [v_quantidade],
    "linhas", [v_linhas],
    "pedidos", [v_pedidos],
    "ticket_medio", [v_ticket_medio],
    "clientes_com_compra", [v_clientes_com_compra],
    "receita_premium", [v_receita_premium],
    "receita_ano_anterior", [v_receita_ano_anterior],
    "receita_acumulada_ano", [v_receita_acumulada_ano],
    "crescimento_pct", [v_crescimento_pct],
    "participacao", [v_participacao],
    "peso_mercado", [v_peso_mercado]
)
ORDER BY [chave]

