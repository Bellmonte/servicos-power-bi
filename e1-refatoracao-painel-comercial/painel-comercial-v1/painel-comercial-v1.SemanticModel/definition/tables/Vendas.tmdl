table Vendas
	lineageTag: 5fc52c2c-0390-5d3d-8451-905114295fd9

	measure 'Margem %' = DIVIDE(SUM(Vendas[Lucro]), SUM(Vendas[receita_liquida]))
		formatString: 0.00%
		lineageTag: 9c19eeff-86db-530f-9aee-ae57b1f390a5

	measure 'Receita Linha Premium' = CALCULATE(SUM(Vendas[receita_liquida]), FILTER(Vendas, Vendas[categoria] = "Linha Premium"))
		formatString: #,0.00
		lineageTag: b4b5c3fc-7193-5ee0-8f33-76279961eda2

	measure 'Clientes com Compra' = COUNTROWS(FILTER(VALUES(Vendas[cliente_id]), CALCULATE(SUM(Vendas[receita_liquida])) > 0))
		formatString: #,0
		lineageTag: 397ebf2c-4be0-53cc-b132-a4c3a1e9f6d2

	measure 'Ticket Médio' = AVERAGEX(VALUES(Vendas[numero_pedido]), CALCULATE(SUM(Vendas[receita_liquida])))
		formatString: #,0.00
		lineageTag: c3efaae8-38b1-5488-a43b-621406b9d884

	measure 'Receita Ano Anterior' =
			CALCULATE(
			    SUM(Vendas[receita_liquida]),
			    SAMEPERIODLASTYEAR(Vendas[data]),
			    ALL(Vendas[ano]), ALL(Vendas[mes]), ALL(Vendas[nome_mes]), ALL(Vendas[ano_mes]),
			    ALL(Vendas[trimestre]), ALL(Vendas[dia_semana]), ALL(Vendas[fim_de_semana]),
			    ALL(Vendas[Mês Ano]), ALL(Vendas[Ordem Mês])
			)
		formatString: #,0.00
		lineageTag: 34e33383-2654-5ecb-9856-91070567dc99

	measure 'Receita Acumulada no Ano' =
			CALCULATE(
			    SUM(Vendas[receita_liquida]),
			    DATESYTD(Vendas[data]),
			    ALL(Vendas[ano]), ALL(Vendas[mes]), ALL(Vendas[nome_mes]), ALL(Vendas[ano_mes]),
			    ALL(Vendas[trimestre]), ALL(Vendas[dia_semana]), ALL(Vendas[fim_de_semana]),
			    ALL(Vendas[Mês Ano]), ALL(Vendas[Ordem Mês])
			)
		formatString: #,0.00
		lineageTag: 7188044f-42f1-5a19-a1d0-cec8b7d34165

	measure 'Crescimento sobre Ano Anterior %' =
			VAR Atual = SUM(Vendas[receita_liquida])
			VAR Anterior =
			    CALCULATE(
			        SUM(Vendas[receita_liquida]),
			        SAMEPERIODLASTYEAR(Vendas[data]),
			        ALL(Vendas[ano]), ALL(Vendas[mes]), ALL(Vendas[nome_mes]), ALL(Vendas[ano_mes]),
			        ALL(Vendas[trimestre]), ALL(Vendas[dia_semana]), ALL(Vendas[fim_de_semana]),
			        ALL(Vendas[Mês Ano]), ALL(Vendas[Ordem Mês])
			    )
			RETURN
			    IF(ISBLANK(Anterior), BLANK(), (Atual - Anterior) / Anterior)
		formatString: 0.00%
		lineageTag: c2490c0f-3ebd-593f-abe3-c9479b52449b

	measure 'Participação na Receita' = DIVIDE(SUM(Vendas[receita_liquida]), CALCULATE(SUM(Vendas[receita_liquida]), ALL(Regioes), ALL(Vendas[regiao]), ALL(Clientes[regiao])))
		formatString: 0.00%
		lineageTag: 077cf151-ecda-5a78-adf0-09222902b43c

