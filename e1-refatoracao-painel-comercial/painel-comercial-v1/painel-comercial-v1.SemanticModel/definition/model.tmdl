model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados","dim_produto","dim_cliente","dim_vendedor","dim_calendario","Vendas","Clientes","Regioes"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table Vendas
ref table Clientes
ref table Regioes

