      {
        "name": "filtroPorteCliente",
        "displayName": "Porte do cliente",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Cliente"
              }
            },
            "Property": "Porte"
          }
        },
        "type": "Categorical",
        "howCreated": "User"
      },
      {
        "name": "filtroVendedor",
        "displayName": "Vendedor",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Vendedor"
              }
            },
            "Property": "Vendedor"
          }
        },
        "type": "Categorical",
        "howCreated": "User"
